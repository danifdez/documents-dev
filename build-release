#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/release/common.sh"

show_help() {
  cat <<'EOF'
Documents release builder

Usage:
  ./build-release <command> --version <semver> [options]

Commands:
  all             Build the complete standalone target
  node            Build the bundled Node.js runtime
  backend         Build Backend
  postgres        Build embedded PostgreSQL
  models          Build Models (default variant: cpu)
  models-cpu      Alias for models --variant cpu
  models-gpu      Alias for models --variant cuda
  frontend        Build the Electron installer
  installer       Alias for frontend
  verify          Verify an existing release directory
  serve           Serve an existing release directory locally
  clean           Remove release staging/output
  help

Options:
  --version VERSION
  --target OS-ARCH
  --output DIR
  --variant cpu|cuda|metal
  --llama-server PATH
  --frontend-format deb|rpm|squirrel|zip
  --port PORT

NODE_ARCHIVE_SHA256 can override the checksum pinned in release.config.json.
PostgreSQL, pgvector and AGE are compiled from source archives pinned in that
configuration. Models requires --llama-server or LLAMA_SERVER_BIN.
EOF
}

COMMAND="${1:-help}"
[ "$#" -eq 0 ] || shift
VERSION="${RELEASE_VERSION:-}"
TARGET=""
OUTPUT=""
VARIANT="cpu"
LLAMA_SERVER="${LLAMA_SERVER_BIN:-}"
FRONTEND_FORMAT="deb"
PORT="8000"

case "$COMMAND" in
  models-cpu) COMMAND="models"; VARIANT="cpu" ;;
  models-gpu) COMMAND="models"; VARIANT="cuda" ;;
  installer) COMMAND="frontend" ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version) VERSION="$2"; shift 2 ;;
    --target) TARGET="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --variant) VARIANT="$2"; shift 2 ;;
    --llama-server) LLAMA_SERVER="$2"; shift 2 ;;
    --frontend-format) FRONTEND_FORMAT="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    *) die "Unknown release argument: $1" 2 ;;
  esac
done

if [ "$COMMAND" = "help" ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "-h" ]; then
  show_help
  exit 0
fi

STAGING_ROOT="$ROOT_DIR/.build-staging/release"
if [ "$COMMAND" = "clean" ]; then
  assert_inside_workspace "$STAGING_ROOT"
  assert_inside_workspace "$ROOT_DIR/release-output"
  rm -rf "$STAGING_ROOT" "$ROOT_DIR/release-output"
  log_info "Release staging and output removed"
  exit 0
fi

[ -n "$VERSION" ] || die "--version is required" 2
validate_semver "$VERSION"
TARGET="${TARGET:-$(detect_target)}"
OUTPUT="${OUTPUT:-$ROOT_DIR/release-output/$VERSION}"
assert_inside_workspace "$OUTPUT"
mkdir -p "$OUTPUT" "$OUTPUT/.metadata/$TARGET" "$OUTPUT/logs" "$STAGING_ROOT"

if [ "$COMMAND" = "verify" ]; then
  DOCUMENTS_REQUIRE_STANDALONE="${DOCUMENTS_REQUIRE_STANDALONE:-0}" \
    node "$ROOT_DIR/scripts/release/verify-release.mjs" "$OUTPUT"
  exit 0
fi

if [ "$COMMAND" = "serve" ]; then
  [ -f "$OUTPUT/release.json" ] || die "Release manifest not found: $OUTPUT/release.json" 3
  log_info "Serving $OUTPUT on http://127.0.0.1:$PORT"
  cd "$OUTPUT"
  exec python3 -m http.server "$PORT" --bind 127.0.0.1
fi

CONFIG="$ROOT_DIR/release.config.json"
require_file "$CONFIG"
require_command node
node - "$CONFIG" "$TARGET" <<'NODE'
const [, , configPath, target] = process.argv;
const config = require(configPath);
if (!config.targets?.[target]) {
  console.error(`Target is not configured: ${target}`);
  process.exit(2);
}
NODE
NODE_VERSION="$(node -p "require('$CONFIG').runtimes.node")"
POSTGRES_VERSION="$(node -p "require('$CONFIG').runtimes.postgres")"
PYINSTALLER_VERSION="$(node -p "require('$CONFIG').runtimes.pyinstaller")"
PIP_VERSION="$(node -p "require('$CONFIG').runtimes.pip")"
PYTHON_VERSION="$(node -p "require('$CONFIG').runtimes.python")"
NODE_ARCHIVE_SHA256_VALUE="${NODE_ARCHIVE_SHA256:-$(node -p "require('$CONFIG').sources?.node?.sha256?.['$TARGET'] || ''")}"
POSTGRES_SOURCE_URL="$(node -p "require('$CONFIG').sources?.postgres?.url || ''")"
POSTGRES_SOURCE_SHA256="$(node -p "require('$CONFIG').sources?.postgres?.sha256 || ''")"
PGVECTOR_SOURCE_URL="$(node -p "require('$CONFIG').sources?.pgvector?.url || ''")"
PGVECTOR_SOURCE_SHA256="$(node -p "require('$CONFIG').sources?.pgvector?.sha256 || ''")"
AGE_SOURCE_URL="$(node -p "require('$CONFIG').sources?.age?.url || ''")"
AGE_SOURCE_SHA512="$(node -p "require('$CONFIG').sources?.age?.sha512 || ''")"
POSTGRES_BUILDER_IMAGE="$(node -p "require('$CONFIG').builders?.postgresLinuxX64 || ''")"

preflight_selected_components() {
  if [ "$COMMAND" = "all" ] || [ "$COMMAND" = "backend" ]; then
    local active_node
    active_node="$(node -p 'process.versions.node')"
    [ "$active_node" = "$NODE_VERSION" ] ||
      die "Backend requires Node $NODE_VERSION on the build host (current: $active_node)" 3
  fi
  if [ "$COMMAND" = "all" ] || [ "$COMMAND" = "node" ]; then
    [ -n "$NODE_ARCHIVE_SHA256_VALUE" ] || die "Node archive checksum is not configured for $TARGET" 3
  fi
  if [ "$COMMAND" = "all" ] || [ "$COMMAND" = "models" ]; then
    local active_python
    active_python="$(python3 -c 'import platform; print(platform.python_version())')"
    [ "$active_python" = "$PYTHON_VERSION" ] ||
      die "Models requires Python $PYTHON_VERSION on the build host (current: $active_python)" 3
    [ -n "$LLAMA_SERVER" ] || die "Models requires --llama-server or LLAMA_SERVER_BIN" 3
    [ -x "$LLAMA_SERVER" ] || die "llama-server is not executable: $LLAMA_SERVER" 3
  fi
  if [ "$COMMAND" = "all" ] || [ "$COMMAND" = "postgres" ]; then
    [ -n "$POSTGRES_SOURCE_URL" ] && [ -n "$POSTGRES_SOURCE_SHA256" ] || die "PostgreSQL source is not configured" 3
    [ -n "$PGVECTOR_SOURCE_URL" ] && [ -n "$PGVECTOR_SOURCE_SHA256" ] || die "pgvector source is not configured" 3
    [ -n "$AGE_SOURCE_URL" ] && [ -n "$AGE_SOURCE_SHA512" ] || die "Apache AGE source is not configured" 3
    [ -n "$POSTGRES_BUILDER_IMAGE" ] || die "PostgreSQL builder image is not configured" 3
  fi
}

preflight_selected_components

package_backend() {
  "$ROOT_DIR/backend/scripts/package-release.sh" \
    --version "$VERSION" --target "$TARGET" --node-version "$NODE_VERSION" \
    --staging "$STAGING_ROOT/backend" --output "$OUTPUT"
}

package_node() {
  "$ROOT_DIR/scripts/release/package-node.sh" \
    --version "$VERSION" --node-version "$NODE_VERSION" --target "$TARGET" \
    --archive-sha256 "$NODE_ARCHIVE_SHA256_VALUE" \
    --staging "$STAGING_ROOT/node" --output "$OUTPUT"
}

package_postgres() {
  local args=(
    --version "$VERSION" --postgres-version "$POSTGRES_VERSION" --target "$TARGET" \
    --postgres-source-url "$POSTGRES_SOURCE_URL" --postgres-source-sha256 "$POSTGRES_SOURCE_SHA256" \
    --pgvector-source-url "$PGVECTOR_SOURCE_URL" --pgvector-source-sha256 "$PGVECTOR_SOURCE_SHA256" \
    --age-source-url "$AGE_SOURCE_URL" --age-source-sha512 "$AGE_SOURCE_SHA512" \
    --staging "$STAGING_ROOT/postgres" --output "$OUTPUT"
  )
  if command -v flex >/dev/null 2>&1 && command -v bison >/dev/null 2>&1; then
    "$ROOT_DIR/scripts/release/package-postgres.sh" "${args[@]}"
  else
    "$ROOT_DIR/scripts/release/build-postgres-container.sh" \
      --image "$POSTGRES_BUILDER_IMAGE" -- "${args[@]}"
  fi
}

package_models() {
  [ -n "$LLAMA_SERVER" ] || die "Models requires --llama-server or LLAMA_SERVER_BIN" 3
  "$ROOT_DIR/models/scripts/package-release.sh" \
    --version "$VERSION" --target "$TARGET" --variant "$VARIANT" \
    --llama-server "$LLAMA_SERVER" --pyinstaller-version "$PYINSTALLER_VERSION" \
    --pip-version "$PIP_VERSION" --python-version "$PYTHON_VERSION" \
    --staging "$STAGING_ROOT/models-$VARIANT" --output "$OUTPUT"
}

package_frontend() {
  "$ROOT_DIR/frontend/scripts/package-release.sh" \
    --version "$VERSION" --target "$TARGET" --format "$FRONTEND_FORMAT" \
    --staging "$STAGING_ROOT/frontend" --output "$OUTPUT"
}

case "$COMMAND" in
  node) package_node ;;
  backend) package_backend ;;
  postgres) package_postgres ;;
  models) package_models ;;
  frontend) package_frontend ;;
  all)
    package_node
    package_backend
    package_postgres
    package_models
    package_frontend
    ;;
  *) die "Unknown release command: $COMMAND" 2 ;;
esac

node "$ROOT_DIR/scripts/release/manifest.mjs" \
  --version "$VERSION" --target "$TARGET" --output "$OUTPUT" --metadata "$OUTPUT/.metadata/$TARGET"
if [ "$COMMAND" = "all" ]; then
  DOCUMENTS_REQUIRE_STANDALONE=1 node "$ROOT_DIR/scripts/release/verify-release.mjs" "$OUTPUT"
else
  node "$ROOT_DIR/scripts/release/verify-release.mjs" "$OUTPUT"
fi

log_info "Release output: $OUTPUT"
